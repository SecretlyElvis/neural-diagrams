  <diagram id="controls-evidence" name="4 - Controls and Notes">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4-title" value="Pipeline controls, ownership and implementation notes" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0f172a;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p4-sub" value="This page records the controls implied by the diagram and the details confirmed in the current repositories, so the overview remains honest as the delivery process evolves." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#475569;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="1550" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p4-owner" value="Responsibility boundary" style="swimlane;html=1;startSize=38;horizontal=1;rounded=0;fillColor=#e2e8f0;swimlaneFillColor=#f8fafc;strokeColor=#64748b;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="30" y="120" width="560" height="430" as="geometry" />
        </mxCell>
        <mxCell id="p4-vendor" value="&lt;b&gt;FSAI / vendor owns&lt;/b&gt;&lt;br&gt;- Product development and testing in vendor INT&lt;br&gt;- Publishing image and chart artifacts to the upstream JFrog repositories&lt;br&gt;- Supplying compatible release inventories and release intent" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=12;fontColor=#334155;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="185" width="500" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p4-bnz" value="&lt;b&gt;BNZ owns from Gate A onward&lt;/b&gt;&lt;br&gt;- Source pins and mirror repositories&lt;br&gt;- Jenkins credentials, builds, scans and internal registry&lt;br&gt;- Deployment repository configuration and approvals&lt;br&gt;- UAT deployment, operational support and InfoSec compliance&lt;br&gt;- Promotion beyond UAT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=12;fontColor=#0c4a6e;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p4-controls" value="Implemented controls" style="swimlane;html=1;startSize=38;horizontal=1;rounded=0;fillColor=#dcfce7;swimlaneFillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="620" y="120" width="560" height="430" as="geometry" />
        </mxCell>
        <mxCell id="p4-controltext" value="&lt;b&gt;Source integrity&lt;/b&gt; - explicit tag/version plus sha256 pins; Helm pipeline verifies the served digest.&#xa;&#xa;&lt;b&gt;Environment compatibility&lt;/b&gt; - image rebuild overlays BNZ CA roots; component-specific Dockerfiles handle alternate trust paths.&#xa;&#xa;&lt;b&gt;Security scanning&lt;/b&gt; - Wiz container-image policies and Wiz IaC scans fail closed before publication.&#xa;&#xa;&lt;b&gt;Separation of duties&lt;/b&gt; - PR/branch runs validate but cannot push; only trunk publication credentials create internal artifacts.&#xa;&#xa;&lt;b&gt;Auditability&lt;/b&gt; - Git PRs, scan reports, immutable digest pins, image provenance labels, Jenkins build history and Argo CD desired-state history." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#86efac;fontSize=11;fontColor=#14532d;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="185" width="500" height="325" as="geometry" />
        </mxCell>
        <mxCell id="p4-runtime" value="Runtime safeguards" style="swimlane;html=1;startSize=38;horizontal=1;rounded=0;fillColor=#fef3c7;swimlaneFillColor=#fffbeb;strokeColor=#d97706;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#78350f;" vertex="1" parent="1">
          <mxGeometry x="1210" y="120" width="560" height="430" as="geometry" />
        </mxCell>
        <mxCell id="p4-runtimetext" value="&lt;b&gt;Internal-only consumption&lt;/b&gt; - deployment Renovate and EKS reference registry.nz.thenational.com, not vendor registries.&#xa;&#xa;&lt;b&gt;Human gate by blast radius&lt;/b&gt; - Atlas chart/image changes and AICW chart changes require review; routine AICW image tags may auto-merge.&#xa;&#xa;&lt;b&gt;GitOps reconciliation&lt;/b&gt; - Argo CD renders with the Helmfile plugin and applies from main with automated prune and self-heal.&#xa;&#xa;&lt;b&gt;Ownership&lt;/b&gt; - vendor publication cannot directly alter UAT; BNZ controls both registry publication and deployment authorization.&#xa;&#xa;&lt;b&gt;Environment scope&lt;/b&gt; - this workbook describes UAT / eks-ppte-50. Production requires its own promotion and approval controls." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#fbbf24;fontSize=11;fontColor=#78350f;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1240" y="185" width="500" height="325" as="geometry" />
        </mxCell>
        <mxCell id="p4-notes" value="Current implementation notes and open points" style="swimlane;html=1;startSize=38;horizontal=1;rounded=0;fillColor=#fee2e2;swimlaneFillColor=#fff7f7;strokeColor=#dc2626;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#7f1d1d;" vertex="1" parent="1">
          <mxGeometry x="30" y="590" width="1120" height="435" as="geometry" />
        </mxCell>
        <mxCell id="p4-n1" value="&lt;b&gt;1. Image signing is not enabled&lt;/b&gt;&lt;br&gt;Both image pipeline bib.yaml files currently set sign.enabled: false. The diagram therefore treats digest pinning and Wiz scanning as implemented controls, but does not claim signature admission." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#f87171;fontSize=11;fontColor=#7f1d1d;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4-n2" value="&lt;b&gt;2. Gate A automation is configuration-driven&lt;/b&gt;&lt;br&gt;All four current mirror-repository renovate.json files set automerge=true. Required branch checks and repository policy still determine whether a PR is actually mergeable." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#f87171;fontSize=11;fontColor=#7f1d1d;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="590" y="660" width="530" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4-n3" value="&lt;b&gt;3. Deployment repo name corrected&lt;/b&gt;&lt;br&gt;The PlantUML used fsai-helm-charts. The implemented platform deployment repository is fsai-atlas-helm-charts; this workbook uses the current name." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#f87171;fontSize=11;fontColor=#7f1d1d;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="805" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4-n4" value="&lt;b&gt;4. Production is intentionally omitted&lt;/b&gt;&lt;br&gt;The source PlantUML and current pipeline design describe non-production deployment into eks-ppte-50. The nonprod-to-prod promotion model should be diagrammed separately once approved." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#f87171;fontSize=11;fontColor=#7f1d1d;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="590" y="805" width="530" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4-n5" value="The mirror process copies charts unchanged, while images are rebuilt to inject BNZ trust roots. That distinction is deliberate and is visible on Gate A page." style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#fff7f7;strokeColor=#fca5a5;fontSize=10;fontColor=#7f1d1d;" vertex="1" parent="1">
          <mxGeometry x="60" y="940" width="1060" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4-sources" value="Evidence used" style="swimlane;html=1;startSize=38;horizontal=1;rounded=0;fillColor=#e0f2fe;swimlaneFillColor=#eff6ff;strokeColor=#0284c7;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#0c4a6e;" vertex="1" parent="1">
          <mxGeometry x="1180" y="590" width="590" height="435" as="geometry" />
        </mxCell>
        <mxCell id="p4-sourcefiles" value="&lt;b&gt;Source diagram&lt;/b&gt;&lt;br&gt;Diagrams/Pipeline-Overview.plantuml&#xa;&#xa;&lt;b&gt;Mirror repositories&lt;/b&gt;&lt;br&gt;fsai-aicw-image-pipeline&lt;br&gt;fsai-atlas-image-pipeline&lt;br&gt;fsai-aicw-helm-pipeline&lt;br&gt;fsai-atlas-helm-pipeline&#xa;&#xa;&lt;b&gt;Deployment repositories&lt;/b&gt;&lt;br&gt;fsai-aicw-helm-charts&lt;br&gt;fsai-atlas-helm-charts&#xa;&#xa;&lt;b&gt;Pipeline registration&lt;/b&gt;&lt;br&gt;fsai-jenkins-dsl&#xa;&#xa;&lt;b&gt;Validated files&lt;/b&gt;&lt;br&gt;Jenkinsfile, renovate.json, bib.yaml, *-helmcharts.json, README.md and Argo CD Application manifests" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#38bdf8;fontSize=11;fontColor=#0c4a6e;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1210" y="655" width="530" height="330" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
