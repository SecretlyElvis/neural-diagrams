        <mxCell id="p3-sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#475569;whiteSpace=wrap;" value="Gate B controls whether an already mirrored artifact becomes desired runtime state. The policy is risk-tiered: platform changes are reviewed; routine AICW image tags may auto-merge." vertex="1">
