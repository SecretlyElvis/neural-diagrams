        <mxCell id="p3-reg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=7;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontColor=#14532d;" value="&lt;b&gt;BNZ internal registry&lt;/b&gt;&lt;br&gt;Only Gate A-approved images and OCI charts" vertex="1">
