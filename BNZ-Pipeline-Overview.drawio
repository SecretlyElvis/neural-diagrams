  <diagram id="gate-a" name="2 - Gate A Mirror Pipelines">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2-title" value="Gate A - controlled mirroring into BNZ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0f172a;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="950" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-sub" value="The mirror repositories convert vendor availability into a BNZ-controlled, digest-pinned and scanned artifact. Validation and publication are deliberately separate branch behaviors." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#475569;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="1580" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2-lifecycle" value="Renovate and Jenkins lifecycle" style="swimlane;html=1;startSize=36;horizontal=1;rounded=0;fillColor=#dbeafe;swimlaneFillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="30" y="115" width="1740" height="225" as="geometry" />
        </mxCell>
        <mxCell id="p2-upstream" value="&lt;b&gt;1. Detect update&lt;/b&gt;&lt;br&gt;Renovate queries JFrog for a new tag/version or changed digest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#60a5fa;fontSize=10;fontColor=#172554;" vertex="1" parent="1">
          <mxGeometry x="60" y="185" width="225" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-pr" value="&lt;b&gt;2. Grouped PR&lt;/b&gt;&lt;br&gt;Update bib.yaml or *-helmcharts.json with version/tag + sha256" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#60a5fa;fontSize=10;fontColor=#172554;" vertex="1" parent="1">
          <mxGeometry x="340" y="185" width="225" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-prbuild" value="&lt;b&gt;3. PR validation&lt;/b&gt;&lt;br&gt;Managed Jenkins pulls/builds, verifies and scans&lt;br&gt;&lt;b&gt;push=false&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#60a5fa;fontSize=10;fontColor=#172554;" vertex="1" parent="1">
          <mxGeometry x="620" y="175" width="225" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2-automerge" value="&lt;b&gt;4. Gate A merge&lt;/b&gt;&lt;br&gt;Current Renovate rules set automerge=true for all four mirror repos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#bfdbfe;strokeColor=#2563eb;strokeWidth=2;fontSize=10;fontColor=#172554;" vertex="1" parent="1">
          <mxGeometry x="900" y="185" width="225" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-trunk" value="&lt;b&gt;5. Trunk publication&lt;/b&gt;&lt;br&gt;Jenkins repeats controls on main/master&lt;br&gt;&lt;b&gt;push=true&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#60a5fa;fontSize=10;fontColor=#172554;" vertex="1" parent="1">
          <mxGeometry x="1180" y="175" width="225" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2-publish" value="&lt;b&gt;6. Internal artifact&lt;/b&gt;&lt;br&gt;Published to registry.nz.thenational.com and becomes visible to Gate B Renovate" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=10;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="1460" y="185" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-upstream" target="p2-pr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-pr" target="p2-prbuild">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e3" value="checks pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p2-prbuild" target="p2-automerge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-automerge" target="p2-trunk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e5" value="controls pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16a34a;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p2-trunk" target="p2-publish">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-images" value="Image mirror pattern - used by AICW and Atlas" style="swimlane;html=1;startSize=36;horizontal=1;rounded=0;fillColor=#fff7ed;swimlaneFillColor=#ffffff;strokeColor=#ea580c;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="30" y="375" width="850" height="440" as="geometry" />
        </mxCell>
        <mxCell id="p2-imgpin" value="&lt;b&gt;Pinned source&lt;/b&gt;&lt;br&gt;bib.yaml&lt;br&gt;tag@sha256&lt;br&gt;Input hash skips unchanged images" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=10;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="60" y="445" width="170" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-imgpull" value="&lt;b&gt;Pull + rebuild&lt;/b&gt;&lt;br&gt;Pull from JFrog&lt;br&gt;Remote BuildKit&lt;br&gt;Overlay BNZ CA trust roots&lt;br&gt;Preserve upstream entrypoint/user" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#fb923c;fontSize=10;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="270" y="430" width="180" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-imgscan" value="&lt;b&gt;Wiz container scan&lt;/b&gt;&lt;br&gt;Critical / High / Medium vulnerability policies&lt;br&gt;Secrets policy&lt;br&gt;Malware policy&lt;br&gt;&lt;br&gt;Failure stops the build" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontSize=10;fontColor=#7f1d1d;" vertex="1" parent="1">
          <mxGeometry x="490" y="420" width="180" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p2-imgpush" value="&lt;b&gt;Push + identify&lt;/b&gt;&lt;br&gt;Publish internal image&lt;br&gt;OCI provenance labels&lt;br&gt;Post-push Wiz digest tag&lt;br&gt;&lt;br&gt;Signing currently disabled" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=10;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="710" y="420" width="145" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p2-ie1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ea580c;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-imgpin" target="p2-imgpull">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-ie2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ea580c;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-imgpull" target="p2-imgscan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-ie3" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16a34a;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p2-imgscan" target="p2-imgpush">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-imgfail" value="&lt;b&gt;Fail closed&lt;/b&gt;&lt;br&gt;No image is pushed when a scan fails. PR builds never publish even when successful." style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#fef2f2;strokeColor=#ef4444;fontSize=10;fontColor=#991b1b;" vertex="1" parent="1">
          <mxGeometry x="490" y="625" width="365" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p2-imgr" value="Repos: fsai-aicw-image-pipeline | fsai-atlas-image-pipeline" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#fff7ed;strokeColor=#fdba74;fontSize=10;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="60" y="745" width="795" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p2-charts" value="Helm chart mirror pattern - used by AICW and Atlas" style="swimlane;html=1;startSize=36;horizontal=1;rounded=0;fillColor=#e0f2fe;swimlaneFillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#0c4a6e;" vertex="1" parent="1">
          <mxGeometry x="920" y="375" width="850" height="440" as="geometry" />
        </mxCell>
        <mxCell id="p2-helmpin" value="&lt;b&gt;Pinned inventory&lt;/b&gt;&lt;br&gt;aicw-helmcharts.json or atlas-helmcharts.json&lt;br&gt;version + sha256 digest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e0f2fe;strokeColor=#38bdf8;fontSize=10;fontColor=#0c4a6e;" vertex="1" parent="1">
          <mxGeometry x="950" y="440" width="170" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2-helmpull" value="&lt;b&gt;Pull + verify&lt;/b&gt;&lt;br&gt;Helm pull from JFrog OCI repository&lt;br&gt;Compare served manifest digest with inventory pin&lt;br&gt;&lt;br&gt;Mismatch fails loudly" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#38bdf8;fontSize=10;fontColor=#0c4a6e;" vertex="1" parent="1">
          <mxGeometry x="1160" y="425" width="180" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p2-helmscan" value="&lt;b&gt;Wiz IaC scan&lt;/b&gt;&lt;br&gt;Scan the packaged Helm chart directly&lt;br&gt;Report written to scan-reports/&lt;br&gt;&lt;br&gt;Failure blocks publication" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontSize=10;fontColor=#7f1d1d;" vertex="1" parent="1">
          <mxGeometry x="1380" y="425" width="180" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p2-helmpush" value="&lt;b&gt;Push unchanged&lt;/b&gt;&lt;br&gt;Helm push to BNZ OCI registry&lt;br&gt;No chart modification&lt;br&gt;Archive scan report as Jenkins build artifact" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=10;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="1600" y="425" width="145" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p2-he1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-helmpin" target="p2-helmpull">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-he2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-helmpull" target="p2-helmscan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-he3" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16a34a;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p2-helmscan" target="p2-helmpush">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-helmfail" value="&lt;b&gt;Fail closed&lt;/b&gt;&lt;br&gt;A digest mismatch or failed Wiz IaC scan prevents helm push. Branch/PR validation uses mirror:check and never pushes." style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#fef2f2;strokeColor=#ef4444;fontSize=10;fontColor=#991b1b;" vertex="1" parent="1">
          <mxGeometry x="1380" y="625" width="365" height="85" as="geometry" />
