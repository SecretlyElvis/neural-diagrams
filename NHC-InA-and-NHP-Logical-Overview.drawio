        <mxCell id="1181" parent="1179" style="text;vsdxID=1090;fillColor=none;gradientColor=none;strokeColor=none;strokeWidth=0;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;labelBackgroundColor=none;rounded=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;overflow=width;;html=1;" value="&lt;div style=&quot;font-size: 1px&quot;&gt;&lt;p style=&quot;text-align:left;margin-left:0;margin-right:0;margin-top:0px;margin-bottom:0px;text-indent:0;vertical-align:top;direction:ltr;&quot;&gt;&lt;font style=&quot;font-size:14.11px;font-family:Arial;color:#000000;direction:ltr;letter-spacing:0px;line-height:100%;opacity:1&quot;&gt;Autoamted process that actively pulls data from 3rd Party sources, performs preliminary transformations and saves to a SQL database .  Generally text such as addresses, claim management system data and GIS information.&lt;br/&gt;&lt;/font&gt;&lt;/p&gt;&lt;/div&gt;" vertex="1">
