        <mxCell id="1" parent="0"/>
        <mxCell id="p3-title" value="Ingress, TLS, authentication and cross-namespace traffic" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0f172a;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1100" height="40" as="geometry"/></mxCell>
        <mxCell id="p3-sub" value="The Gateway API data plane is live and Programmed. Transitional NGINX Ingress and Certificate status remain intentionally hidden by cluster-level RBAC." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#475569;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1500" height="30" as="geometry"/></mxCell>

        <mxCell id="p3-patha" value="Path A - Gateway API / kGateway (live-observed data plane)" style="swimlane;html=1;startSize=34;horizontal=1;rounded=0;fillColor=#dbeafe;swimlaneFillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="30" y="115" width="1740" height="300" as="geometry"/></mxCell>
        <mxCell id="p3-client" value="&lt;b&gt;Internal client&lt;/b&gt;&lt;br&gt;BNZ network" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#475569;strokeWidth=2;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="60" y="205" width="145" height="65" as="geometry"/></mxCell>
        <mxCell id="p3-dns" value="&lt;b&gt;DNS names&lt;/b&gt;&lt;br&gt;grafana.fsai.bnz&lt;br&gt;temporal.fsai.bnz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#60a5fa;fontSize=11;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="245" y="190" width="160" height="95" as="geometry"/></mxCell>
        <mxCell id="p3-nlb" value="&lt;b&gt;Internal AWS NLB&lt;/b&gt;&lt;br&gt;LoadBalancer Service has an internal ap-southeast-2 ELB address&lt;br&gt;IP target mode / TCP 443" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#60a5fa;fontSize=10;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="445" y="180" width="180" height="110" as="geometry"/></mxCell>
        <mxCell id="p3-envoy" value="&lt;b&gt;Envoy: internal-gateway&lt;/b&gt;&lt;br&gt;Deployment 1/1&lt;br&gt;Gateway Programmed=True&lt;br&gt;HTTPS listener :443 / TLS termination" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#bfdbfe;strokeColor=#2563eb;strokeWidth=2;fontSize=10;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="665" y="180" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="p3-cert" value="&lt;b&gt;kgateway-tls&lt;/b&gt;&lt;br&gt;cert-manager Certificate&lt;br&gt;ClusterIssuer bnz-paas (Venafi)&lt;br&gt;DNS: argocd, grafana, temporal .fsai.bnz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8fafc;strokeColor=#64748b;dashed=1;fontSize=10;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="665" y="310" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="p3-graf-route" value="&lt;b&gt;HTTPRoute: grafana-route&lt;/b&gt;&lt;br&gt;Observed in fsai-observability&lt;br&gt;grafana.fsai.bnz&lt;br&gt;kube-prom-stack-grafana:80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fef3c7;strokeColor=#d97706;fontSize=11;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="925" y="155" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="p3-temp-route" value="&lt;b&gt;HTTPRoute: temporal-web-route&lt;/b&gt;&lt;br&gt;Observed in fsai-orchestrator&lt;br&gt;temporal.fsai.bnz&lt;br&gt;Direct to temporal-web:8080" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=10;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="925" y="280" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="p3-authout" value="&lt;b&gt;HTTPRoute: Authentik outpost&lt;/b&gt;&lt;br&gt;Observed in fsai-security with the same temporal.fsai.bnz hostname&lt;br&gt;Proxy outpost Deployment is 0/1, so this path is not healthy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=10;fontColor=#991b1b;" vertex="1" parent="1"><mxGeometry x="1205" y="185" width="235" height="125" as="geometry"/></mxCell>
        <mxCell id="p3-public" value="&lt;b&gt;Public gateway&lt;/b&gt;&lt;br&gt;Disabled" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1495" y="205" width="170" height="65" as="geometry"/></mxCell>
        <mxCell id="p3-a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p3-client" target="p3-dns"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-a2" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="p3-dns" target="p3-nlb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-a3" value="TCP 443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="p3-nlb" target="p3-envoy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p3-envoy" target="p3-graf-route"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p3-envoy" target="p3-temp-route"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-a6" value="Secret ref" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748b;dashed=1;endArrow=open;endFill=0;fontSize=10;" edge="1" parent="1" source="p3-cert" target="p3-envoy"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p3-pathb" value="Path B - temporary NGINX Ingress resources (declared in Git; live listing RBAC-restricted)" style="swimlane;html=1;startSize=34;horizontal=1;rounded=0;fillColor=#fef3c7;swimlaneFillColor=#fffbeb;strokeColor=#d97706;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="30" y="445" width="1740" height="235" as="geometry"/></mxCell>
        <mxCell id="p3-tclient" value="&lt;b&gt;Internal client&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#475569;fontSize=11;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="60" y="535" width="145" height="55" as="geometry"/></mxCell>
        <mxCell id="p3-hosts" value="&lt;b&gt;eks-ppte-50.k8s.bnz hosts&lt;/b&gt;&lt;br&gt;fsai-argo-nonprod&lt;br&gt;fsai-authentik-nonprod&lt;br&gt;fsai-grafana-nonprod&lt;br&gt;fsai-temporal-nonprod" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#fbbf24;fontSize=10;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="250" y="490" width="210" height="140" as="geometry"/></mxCell>
        <mxCell id="p3-nginx" value="&lt;b&gt;NGINX IngressClass&lt;/b&gt;&lt;br&gt;Controller is cluster-provided / outside Atlas repo&lt;br&gt;TLS Secrets created via cert-manager annotations" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=11;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="515" y="505" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="p3-argo-svc" value="&lt;b&gt;Argo CD server&lt;/b&gt;&lt;br&gt;fsai-orchestrator :80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=10;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="850" y="475" width="185" height="60" as="geometry"/></mxCell>
        <mxCell id="p3-auth-svc" value="&lt;b&gt;Authentik server&lt;/b&gt;&lt;br&gt;fsai-security :80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=10;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="1080" y="475" width="185" height="60" as="geometry"/></mxCell>
        <mxCell id="p3-graf-svc" value="&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;fsai-observability :80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fef3c7;strokeColor=#d97706;fontSize=10;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="850" y="580" width="185" height="60" as="geometry"/></mxCell>
        <mxCell id="p3-temp-svc" value="&lt;b&gt;Temporal Web&lt;/b&gt;&lt;br&gt;fsai-orchestrator :8080" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=10;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="1080" y="580" width="185" height="60" as="geometry"/></mxCell>
        <mxCell id="p3-manual" value="temporary-resources is Synced / Healthy, but the caller cannot list Ingress objects cluster-wide. The four declared rules and their controller/DNS status therefore remain repository-derived rather than live-confirmed." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#fff7ed;strokeColor=#fdba74;fontSize=10;fontColor=#7c2d12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1320" y="500" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="p3-b1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d97706;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p3-tclient" target="p3-hosts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-b2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d97706;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p3-hosts" target="p3-nginx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-b3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d97706;endArrow=block;endFill=1;" edge="1" parent="1" source="p3-nginx" target="p3-argo-svc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="505"/></Array></mxGeometry></mxCell>
        <mxCell id="p3-b4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d97706;endArrow=block;endFill=1;" edge="1" parent="1" source="p3-nginx" target="p3-auth-svc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="560"/></Array></mxGeometry></mxCell>
        <mxCell id="p3-b5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d97706;endArrow=block;endFill=1;" edge="1" parent="1" source="p3-nginx" target="p3-graf-svc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="610"/></Array></mxGeometry></mxCell>
        <mxCell id="p3-b6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d97706;endArrow=block;endFill=1;" edge="1" parent="1" source="p3-nginx" target="p3-temp-svc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="560"/></Array></mxGeometry></mxCell>

        <mxCell id="p3-ident" value="Identity and service-to-service authentication" style="swimlane;html=1;startSize=34;horizontal=1;rounded=0;fillColor=#fee2e2;swimlaneFillColor=#fff7f7;strokeColor=#dc2626;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="30" y="710" width="1160" height="390" as="geometry"/></mxCell>
        <mxCell id="p3-authn" value="&lt;b&gt;Authentik server + worker&lt;/b&gt;&lt;br&gt;Identity broker backed by Aurora&lt;br&gt;Blueprints define groups/scopes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fecaca;strokeColor=#dc2626;strokeWidth=2;fontSize=11;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="70" y="785" width="210" height="95" as="geometry"/></mxCell>
        <mxCell id="p3-grafoidc" value="&lt;b&gt;Grafana OIDC&lt;/b&gt;&lt;br&gt;Native generic OAuth&lt;br&gt;group-to-role mapping" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fef3c7;strokeColor=#d97706;fontSize=10;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="365" y="750" width="190" height="75" as="geometry"/></mxCell>
        <mxCell id="p3-argooidc" value="&lt;b&gt;Argo CD OIDC&lt;/b&gt;&lt;br&gt;Issuer uses temporary Authentik host&lt;br&gt;Local admin also enabled in values" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=10;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="365" y="845" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="p3-tproxy" value="&lt;b&gt;Temporal Web proxy app&lt;/b&gt;&lt;br&gt;HTTPRoute exists, but Authentik outpost Deployment is 0/1 ready" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=10;fontColor=#991b1b;" vertex="1" parent="1"><mxGeometry x="365" y="945" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="p3-aria" value="&lt;b&gt;Aria&lt;/b&gt;&lt;br&gt;OAuth2 client credentials for Temporal&lt;br&gt;TEMPORAL_HOST currently points to temporal-frontend:7233" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontSize=10;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="645" y="785" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="p3-jwksf" value="&lt;b&gt;Temporal JWKS frontend&lt;/b&gt;&lt;br&gt;Fetches Authentik JWKS and validates permissions claim&lt;br&gt;Configured URI still contains &amp;lt;AICW&amp;gt; placeholder" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dcfce7;strokeColor=#16a34a;dashed=1;fontSize=10;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="925" y="785" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p3-netpol" value="&lt;b&gt;Calico / Kubernetes NetworkPolicies&lt;/b&gt;&lt;br&gt;Cluster GlobalNetworkPolicy defaults pod traffic to deny. Repo policies explicitly allow Envoy -&gt; Grafana/Temporal/Authentik, Aria -&gt; Temporal/Authentik, Prometheus scrapes, and Temporal internal ports." style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f8fafc;strokeColor=#64748b;fontSize=10;fontColor=#334155;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="645" y="925" width="500" height="100" as="geometry"/></mxCell>
        <mxCell id="p3-i1" value="authorize/token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p3-grafoidc" target="p3-authn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-i2" value="OIDC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p3-argooidc" target="p3-authn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-i3" value="client token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ea580c;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p3-aria" target="p3-authn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-i4" value="JWKS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16a34a;dashed=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p3-jwksf" target="p3-authn"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p3-checks" value="Live findings and remaining visibility gaps" style="swimlane;html=1;startSize=34;horizontal=1;rounded=0;fillColor=#e2e8f0;swimlaneFillColor=#f8fafc;strokeColor=#64748b;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1220" y="710" width="550" height="390" as="geometry"/></mxCell>
        <mxCell id="p3-checktext" value="&lt;b&gt;Confirmed&lt;/b&gt;&#xa;1. internal-gateway is Programmed=True and its Envoy Deployment is 1/1.&#xa;&#xa;2. Grafana and two Temporal-host HTTPRoutes exist. The direct Temporal route and Authentik outpost route currently share temporal.fsai.bnz.&#xa;&#xa;&lt;b&gt;Operational issue&lt;/b&gt;&#xa;3. The Authentik proxy outpost is 0/1 ready.&#xa;&#xa;&lt;b&gt;Still unknown under current RBAC&lt;/b&gt;&#xa;4. HTTPRoute Accepted/ResolvedRefs conditions, NGINX Ingress objects, Certificate readiness/SANs and live NetworkPolicies.&#xa;&#xa;5. Aria's direct temporal-frontend endpoint remains Git-derived; runtime environment was not inspected." style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;fontColor=#334155;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1250" y="765" width="490" height="290" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="data-observability" name="4 - Data and Observability">
    <mxGraphModel dx="1800" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p4-title" value="Data services, secrets and observability flows" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0f172a;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="p4-sub" value="Live UAT confirms the in-cluster workloads and bound PVCs shown here. AWS service configuration remains derived from Terraform and Helm values." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#475569;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1500" height="30" as="geometry"/></mxCell>

        <mxCell id="p4-vault" value="&lt;b&gt;HashiCorp Vault&lt;/b&gt;&lt;br&gt;fsai_platform/uat shared platform paths&lt;br&gt;fsai/aria-uat coworker paths + DB static role" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="30" y="125" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="p4-vso" value="&lt;b&gt;Vault Secrets Operator&lt;/b&gt;&lt;br&gt;Cluster-managed CRDs/controller&lt;br&gt;VaultAuth + VaultStaticSecret / DynamicSecret" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8fafc;strokeColor=#64748b;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="330" y="125" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="p4-k8ssecrets" value="&lt;b&gt;Kubernetes Secrets by namespace&lt;/b&gt;&lt;br&gt;fsai-orchestrator: Temporal DB&lt;br&gt;fsai-security: Authentik + forge credentials&lt;br&gt;fsai-observability: Grafana/exporters&lt;br&gt;aicw-aria: DB/Redis/S3/OAuth/Graph" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#64748b;fontSize=10;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="630" y="110" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="p4-v1" value="JWT auth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748b;dashed=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p4-vso" target="p4-vault"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-v2" value="sync / rotate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748b;dashed=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p4-vso" target="p4-k8ssecrets"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p4-workloads" value="Workloads in EKS" style="swimlane;html=1;startSize=34;horizontal=1;rounded=0;fillColor=#e0f2fe;swimlaneFillColor=#f8fafc;strokeColor=#0284c7;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#0c4a6e;" vertex="1" parent="1"><mxGeometry x="30" y="285" width="900" height="790" as="geometry"/></mxCell>
        <mxCell id="p4-temporal" value="&lt;b&gt;Temporal services&lt;/b&gt;&lt;br&gt;Observed Deployments 1/1&lt;br&gt;Persistence + visibility over TLS&lt;br&gt;Argo app Healthy / OutOfSync" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff7ed;strokeColor=#f97316;strokeWidth=2;fontSize=10;fontColor=#9a3412;" vertex="1" parent="1"><mxGeometry x="60" y="345" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="p4-auth" value="&lt;b&gt;Authentik server + worker&lt;/b&gt;&lt;br&gt;Both observed 1/1&lt;br&gt;External PostgreSQL over TLS&lt;br&gt;Proxy outpost separately 0/1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontSize=10;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="p4-aria" value="&lt;b&gt;Aria bedrock-worker&lt;/b&gt;&lt;br&gt;Deployment 1/1 | Service :8080&lt;br&gt;Postgres + Redis + S3 memory" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontSize=10;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="60" y="595" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="p4-forges" value="&lt;b&gt;postgres-forge + redis-forge&lt;/b&gt;&lt;br&gt;fsai-security CronJobs&lt;br&gt;Reconcile databases/users and Redis users/ACLs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fecaca;strokeColor=#dc2626;dashed=1;fontSize=10;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="60" y="730" width="210" height="100" as="geometry"/></mxCell>

        <mxCell id="p4-prom" value="&lt;b&gt;Prometheus&lt;/b&gt;&lt;br&gt;StatefulSet 1/1; no PVC observed&lt;br&gt;7-day / 60 GB local limit&lt;br&gt;Remote-writes metrics to Mimir" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=10;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="340" y="345" width="235" height="115" as="geometry"/></mxCell>
        <mxCell id="p4-graf" value="&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;StatefulSet 1/1&lt;br&gt;Queries Mimir and Loki&lt;br&gt;Bound 20 Gi ebs-sc PVC&lt;br&gt;Authentik OIDC + local admin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=10;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="630" y="345" width="235" height="105" as="geometry"/></mxCell>
        <mxCell id="p4-mimir" value="&lt;b&gt;Mimir&lt;/b&gt;&lt;br&gt;All observed components 1/1&lt;br&gt;S3 blocks plus bound 2 Gi PVCs for compactor, ingester and store gateway" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fef3c7;strokeColor=#d97706;fontSize=10;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="340" y="500" width="235" height="120" as="geometry"/></mxCell>
        <mxCell id="p4-loki" value="&lt;b&gt;Loki&lt;/b&gt;&lt;br&gt;SingleBinary StatefulSet 1/1&lt;br&gt;Bound 10 Gi ebs-sc PVC&lt;br&gt;S3 object storage; 90-day retention" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fef3c7;strokeColor=#d97706;fontSize=10;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="630" y="500" width="235" height="120" as="geometry"/></mxCell>
        <mxCell id="p4-export" value="&lt;b&gt;Metric exporters&lt;/b&gt;&lt;br&gt;postgres-exporter -&gt; Atlas Aurora&lt;br&gt;redis-exporter -&gt; Atlas Eve Redis" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#fbbf24;fontSize=10;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="340" y="660" width="235" height="85" as="geometry"/></mxCell>
        <mxCell id="p4-promtail" value="&lt;b&gt;Confirmed log collection gap&lt;/b&gt;&lt;br&gt;A Promtail DaemonSet object exists with desired 4, but current/ready are 0/0. Events are RBAC-restricted, so the immediate scheduling/admission reason was not captured." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=10;fontColor=#991b1b;" vertex="1" parent="1"><mxGeometry x="630" y="660" width="235" height="100" as="geometry"/></mxCell>
        <mxCell id="p4-argoredis" value="&lt;b&gt;Argo CD cache confirmed&lt;/b&gt;&lt;br&gt;Live Argo CD uses an in-cluster argocd-redis Deployment and ClusterIP Service, both healthy at one replica. The external ElastiCache resource remains provisioned but is not the observed Argo cache." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ecfdf5;strokeColor=#10b981;fontSize=10;fontColor=#065f46;" vertex="1" parent="1"><mxGeometry x="340" y="800" width="525" height="105" as="geometry"/></mxCell>
        <mxCell id="p4-obsnote" value="Prometheus CRDs are cluster-managed. The FSAI operator uses controller-id=fsai and selectors labelled prometheus-operator/managed-by=fsai to avoid contention with BNZ's operator." style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=10;fontColor=#334155;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="950" width="805" height="75" as="geometry"/></mxCell>

        <mxCell id="p4-data" value="AWS data plane" style="swimlane;html=1;startSize=34;horizontal=1;rounded=0;fillColor=#e2e8f0;swimlaneFillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="980" y="110" width="790" height="965" as="geometry"/></mxCell>
        <mxCell id="p4-rdsatlas" value="&lt;b&gt;Aurora Serverless v2: atlas&lt;/b&gt;&lt;br&gt;PostgreSQL 15.12 | 0.5-5 ACU | 14-day backup&lt;br&gt;Logical DBs/users provisioned by postgres-forge:&lt;br&gt;- temporal / temporal persistence users&lt;br&gt;- temporal_visibility / visibility user&lt;br&gt;- authentik / authentik_user&lt;br&gt;- postgres / postgres_exporter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontSize=10;fontColor=#0f172a;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1020" y="170" width="330" height="185" as="geometry"/></mxCell>
        <mxCell id="p4-rdsaria" value="&lt;b&gt;Aurora Serverless v2: aria&lt;/b&gt;&lt;br&gt;Dedicated coworker cluster&lt;br&gt;Database aria / user aria_user&lt;br&gt;pgvector extension&lt;br&gt;postgres_exporter monitoring user" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontSize=10;fontColor=#7c2d12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1385" y="170" width="335" height="145" as="geometry"/></mxCell>
        <mxCell id="p4-rediseve" value="&lt;b&gt;ElastiCache: atlas-eve-bnz-uat&lt;/b&gt;&lt;br&gt;Redis 7.1, one shard + one replica, TLS&lt;br&gt;App/admin and exporter users maintained by redis-forge" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8fafc;strokeColor=#475569;fontSize=10;fontColor=#0f172a;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1020" y="400" width="330" height="105" as="geometry"/></mxCell>
        <mxCell id="p4-redisaria" value="&lt;b&gt;ElastiCache: aicw-aria-bnz-uat&lt;/b&gt;&lt;br&gt;Dedicated coworker cache, TLS&lt;br&gt;Aria app user maintained by redis-forge" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=10;fontColor=#7c2d12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1385" y="400" width="335" height="105" as="geometry"/></mxCell>
        <mxCell id="p4-redisarg" value="&lt;b&gt;ElastiCache: external Argo CD cache resource&lt;/b&gt;&lt;br&gt;Provisioned by Terraform, but no live Argo CD consumer was observed; live Argo CD uses its in-cluster Redis Deployment and Service." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff7ed;strokeColor=#f97316;dashed=1;fontSize=10;fontColor=#9a3412;" vertex="1" parent="1"><mxGeometry x="1020" y="535" width="700" height="70" as="geometry"/></mxCell>
        <mxCell id="p4-s3loki" value="&lt;b&gt;S3: fsai-loki-bnz-uat&lt;/b&gt;&lt;br&gt;Chunks, ruler and admin prefixes&lt;br&gt;SSE-KMS; accessed by observability-sa IRSA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8fafc;strokeColor=#475569;fontSize=10;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1020" y="650" width="215" height="100" as="geometry"/></mxCell>
        <mxCell id="p4-s3mimir" value="&lt;b&gt;S3: fsai-mimir-bnz-uat&lt;/b&gt;&lt;br&gt;blocks, alertmanager and ruler prefixes&lt;br&gt;SSE-KMS; accessed by observability-sa IRSA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8fafc;strokeColor=#475569;fontSize=10;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1250" y="650" width="215" height="100" as="geometry"/></mxCell>
        <mxCell id="p4-s3mem" value="&lt;b&gt;S3: fsai-atlas-memory-bnz-uat&lt;/b&gt;&lt;br&gt;Shared bucket with per-coworker prefix&lt;br&gt;Aria has access only to aria/* via its IRSA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=10;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="1480" y="650" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="p4-bedrock" value="&lt;b&gt;AWS Bedrock&lt;/b&gt;&lt;br&gt;Application inference profiles are scoped to Aria's IRSA:&lt;br&gt;Claude Haiku 4.5, Sonnet 4.6, Opus 4.8, Titan Embed Text v2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=10;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="1020" y="800" width="330" height="115" as="geometry"/></mxCell>
        <mxCell id="p4-ebs" value="&lt;b&gt;Bound EBS volumes via ebs-sc&lt;/b&gt;&lt;br&gt;Grafana: 20 Gi RWO | Loki: 10 Gi RWO&lt;br&gt;Mimir compactor: 2 Gi RWO&lt;br&gt;Mimir ingester: 2 Gi RWO&lt;br&gt;Mimir store gateway: 2 Gi RWO&lt;br&gt;No Prometheus or Alertmanager PVC observed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8fafc;strokeColor=#475569;fontSize=9;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1385" y="800" width="335" height="115" as="geometry"/></mxCell>
        <mxCell id="p4-awsnote" value="All listed S3 buckets use public-access blocks and KMS encryption. Aurora and ElastiCache are reached over private VPC networking; cluster GlobalNetworkPolicy permits the relevant AWS destinations." style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=10;fontColor=#334155;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1020" y="955" width="700" height="70" as="geometry"/></mxCell>

        <mxCell id="p4-e-temp-rds" value="SQL TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16a34a;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p4-temporal" target="p4-rdsatlas"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e-auth-rds" value="SQL TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p4-auth" target="p4-rdsatlas"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e-aria-rds" value="SQL TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ea580c;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p4-aria" target="p4-rdsaria"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e-aria-red" value="Redis TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ea580c;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p4-aria" target="p4-redisaria"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e-aria-s3" value="IRSA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ea580c;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p4-aria" target="p4-s3mem"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e-aria-bed" value="InvokeModel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ea580c;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p4-aria" target="p4-bedrock"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e-forge-rds" value="provision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;dashed=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p4-forges" target="p4-rdsatlas"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e-prom-mimir" value="remote_write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d97706;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p4-prom" target="p4-mimir"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e-mimir-s3" value="IRSA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d97706;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p4-mimir" target="p4-s3mimir"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e-loki-s3" value="IRSA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d97706;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p4-loki" target="p4-s3loki"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e-graf-mimir" value="PromQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d97706;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p4-graf" target="p4-mimir"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e-graf-loki" value="LogQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d97706;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p4-graf" target="p4-loki"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e-exp-rds" value="metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d97706;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p4-export" target="p4-rdsatlas"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e-exp-red" value="metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d97706;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="p4-export" target="p4-rediseve"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="validation" name="5 - Live Validation">
    <mxGraphModel dx="1800" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p5-title" value="Live cluster validation and diagram confidence" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0f172a;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="p5-sub" value="Evidence snapshot captured from UAT on 8 October 2026. Green items are live-confirmed; amber/red items need operational attention or narrower follow-up access." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#475569;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1550" height="35" as="geometry"/></mxCell>

        <mxCell id="p5-high" value="Confirmed live UAT state" style="swimlane;html=1;startSize=38;horizontal=1;rounded=0;fillColor=#dcfce7;swimlaneFillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="550" height="860" as="geometry"/></mxCell>
        <mxCell id="p5-hightext" value="&lt;b&gt;GitOps&lt;/b&gt;&#xa;- 24 Argo CD Applications are Healthy.&#xa;- 23 are Synced; Temporal is the exception.&#xa;- Atlas apps report revision cc1e2046; Aria reports 99771a8.&#xa;&#xa;&lt;b&gt;Networking&lt;/b&gt;&#xa;- internal-gateway and kgateway Deployments are 1/1.&#xa;- Gateway internal-gateway is Programmed=True and backed by an internal AWS ELB.&#xa;- Grafana and two temporal.fsai.bnz HTTPRoutes exist.&#xa;&#xa;&lt;b&gt;Runtime&lt;/b&gt;&#xa;- Argo CD components and in-cluster Redis are 1/1.&#xa;- Temporal runtime components are 1/1.&#xa;- Authentik server and worker are 1/1.&#xa;- Aria bedrock-worker is 1/1 with ClusterIP Service :8080.&#xa;- fsai-system has no workloads or pods and only the default ServiceAccount.&#xa;&#xa;&lt;b&gt;Storage&lt;/b&gt;&#xa;- Five ebs-sc PVCs are Bound: Grafana 20 Gi, Loki 10 Gi, and three Mimir PVCs at 2 Gi each." style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#86efac;fontSize=11;fontColor=#14532d;align=left;verticalAlign=top;spacingTop=14;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="490" height="750" as="geometry"/></mxCell>

        <mxCell id="p5-verify" value="Operational exceptions and open questions" style="swimlane;html=1;startSize=38;horizontal=1;rounded=0;fillColor=#fef3c7;swimlaneFillColor=#fffbeb;strokeColor=#d97706;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="610" y="120" width="560" height="860" as="geometry"/></mxCell>
        <mxCell id="p5-verifytext" value="&lt;b&gt;1. Temporal drift&lt;/b&gt;&#xa;The Temporal Application is Healthy but OutOfSync. Runtime is available, but desired and live state differ; inspect the Argo diff before the next sync.&#xa;&#xa;&lt;b&gt;2. Authentik proxy outpost unavailable&lt;/b&gt;&#xa;The ak-outpost-kgateway-outpost Deployment exists at 0/1. A matching HTTPRoute also claims temporal.fsai.bnz alongside the direct Temporal route. Confirm route conditions and intended authentication path.&#xa;&#xa;&lt;b&gt;3. Log ingestion gap&lt;/b&gt;&#xa;Promtail DaemonSet desired=4, current=0, ready=0. Loki itself is healthy, but this capture does not identify another source feeding it. Events were not accessible.&#xa;&#xa;&lt;b&gt;4. Live-only Argo application&lt;/b&gt;&#xa;rbac-resources is Synced / Healthy in UAT but absent from the reviewed local Atlas checkout. Reconcile the source branch/revision before treating Git inventory as complete.&#xa;&#xa;&lt;b&gt;5. External Argo Redis&lt;/b&gt;&#xa;Terraform provisions it, but live Argo CD demonstrably uses in-cluster argocd-redis. Confirm whether the external resource should be retired or reserved for a future design.&#xa;&#xa;&lt;b&gt;6. Identity details remain repository-derived&lt;/b&gt;&#xa;Aria's Temporal endpoint and the JWKS placeholder were not checked from the live pod environment." style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#fbbf24;fontSize=11;fontColor=#78350f;align=left;verticalAlign=top;spacingTop=14;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="640" y="180" width="500" height="750" as="geometry"/></mxCell>

        <mxCell id="p5-commands" value="Evidence coverage and access boundaries" style="swimlane;html=1;startSize=38;horizontal=1;rounded=0;fillColor=#dbeafe;swimlaneFillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="1200" y="120" width="570" height="860" as="geometry"/></mxCell>
        <mxCell id="p5-cmd1" value="Argo CD: application names, sync/health and revisions captured successfully." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#e0f2fe;strokeColor=#38bdf8;fontSize=11;fontColor=#0c4a6e;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1230" y="185" width="510" height="58" as="geometry"/></mxCell>
        <mxCell id="p5-cmd2" value="Namespace workloads: Deployments, StatefulSets, DaemonSets, CronJobs, Services and PVCs captured for all FSAI namespaces plus aicw-aria." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#e0f2fe;strokeColor=#38bdf8;fontSize=11;fontColor=#0c4a6e;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1230" y="265" width="510" height="82" as="geometry"/></mxCell>
        <mxCell id="p5-cmd3" value="Gateway API: Gateway address/Programmed state, HTTPRoute hostnames and ReferenceGrant inventory captured." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#e0f2fe;strokeColor=#38bdf8;fontSize=11;fontColor=#0c4a6e;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1230" y="370" width="510" height="58" as="geometry"/></mxCell>
        <mxCell id="p5-cmd4" value="RBAC denied cluster-wide Ingress and cert-manager Certificate listings. This is an intentional platform-team information boundary, not evidence that either resource type is absent." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=11;fontColor=#9a3412;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1230" y="450" width="510" height="72" as="geometry"/></mxCell>
        <mxCell id="p5-cmd5" value="RBAC denied cluster-wide NetworkPolicy listing. fsai-system itself was queryable and confirmed empty except for its default ServiceAccount." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=11;fontColor=#9a3412;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1230" y="545" width="510" height="90" as="geometry"/></mxCell>
        <mxCell id="p5-cmd6" value="RBAC denied cluster-wide labelled pod and event listings. This prevents confirming Promtail admission/scheduling errors and broader platform components from this capture." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=11;fontColor=#9a3412;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1230" y="660" width="510" height="78" as="geometry"/></mxCell>
        <mxCell id="p5-safety" value="The capture contains operational metadata only. It does not include Secret values, pod environment variables, log content or user data." style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#fef2f2;strokeColor=#ef4444;fontSize=11;fontColor=#991b1b;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1230" y="770" width="510" height="65" as="geometry"/></mxCell>
        <mxCell id="p5-next" value="Useful next evidence, where namespace RBAC permits it: Argo diff for Temporal; describe/logs for the Authentik outpost; Promtail DaemonSet events; HTTPRoute status conditions; and namespace-scoped Ingress, Certificate and NetworkPolicy listings." style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#eff6ff;strokeColor=#60a5fa;fontSize=11;fontColor=#1e3a8a;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1230" y="860" width="510" height="75" as="geometry"/></mxCell>

        <mxCell id="p5-sources" value="Sources: reviewed Git repositories plus Reference/Overview-Fine-Tuning.txt, containing kubectl output captured from UAT. Diagram refreshed 8 October 2026. Live state is a point-in-time observation and should be revalidated after deployments." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=10;fontColor=#475569;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="1020" width="1740" height="55" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
